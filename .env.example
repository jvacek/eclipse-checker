# Sentry error monitoring + tracing (React SDK)
# Copy to .env.local for local dev. In production (Vercel), set these in the
# project's Environment Variables so the build bakes them in.
VITE_SENTRY_DSN=

# Source-map + release upload at build time (@sentry/vite-plugin).
# SENTRY_AUTH_TOKEN is a secret — only set it in the deploy environment, never
# in the repo. Without it the build still succeeds (uploads are skipped).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional; defaults to the package.json version.
VITE_APP_VERSION=
